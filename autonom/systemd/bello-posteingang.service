[Unit]
Description=Bello: Postfach lesen und handeln
Documentation=file://@PFAD@/autonom/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=@BENUTZER@
WorkingDirectory=@PFAD@
Environment=PYTHONPATH=@PFAD@
ExecStart=@PFAD@/venv/bin/python autonom/posteingang.py
TimeoutStartSec=120

# Haerten: der Dienst darf nur in seinem eigenen Ordner schreiben.
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=@PFAD@
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

StandardOutput=append:@PFAD@/logs/posteingang.log
StandardError=append:@PFAD@/logs/posteingang.log
